@page
@model CoursesModel
@{
    ViewData["Title"] = "View Courses";
}

<div class="container mt-4">
    <h2>Available Courses</h2>
    <div class="row">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text">@course.Description</p>
                        <p><strong>Instructor:</strong> @course.Instructor</p>
                        <p><strong>Duration:</strong> @course.Duration</p>
                        <a href="@Url.Page("/Courses/Edit", new { id = course.CourseId })" class="btn btn-primary">Edit</a>
                        <a href="@Url.Page("/Courses/Delete", new { id = course.CourseId })" class="btn btn-danger">Delete</a>
                        <a href="@Url.Page("/Courses/ViewRegistrations", new { id = course.CourseId })" class="btn btn-info">View Students</a>                        
                    </div>
                </div>
            </div>
        }
    </div>
</div>
