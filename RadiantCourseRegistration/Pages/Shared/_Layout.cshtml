<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RadiantCourseRegistration</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <!-- Font Awesome (for icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        /* Sidebar Styles */
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #343a40;
            color: white;
            padding-top: 20px;
            transition: 0.3s;
        }

            .sidebar a {
                display: block;
                color: white;
                padding: 15px;
                text-decoration: none;
                transition: 0.3s;
            }

                .sidebar a:hover {
                    background-color: #495057;
                    text-decoration: none;
                }

            .sidebar .active {
                background-color: #007bff;
            }

        /* Main Content Wrapper */
        .main-content {
            margin-left: 250px;
            transition: margin-left 0.3s;
        }

        /* Adjust content position */
        .content {
            padding: 80px 20px 20px;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h3 class="text-center">Radiant</h3>
        <a asp-page="/Index"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a asp-page="/Index"><i class="fas fa-home"></i> Home</a>
        <a asp-page="/Register"><i class="fas fa-edit"></i> Register Courses</a>
        <a asp-page="/Courses"><i class="fas fa-book"></i> View Courses</a>
        <a asp-page="/Blog"><i class="fas fa-blog"></i> Radiant Blog</a>
        <a asp-page="/Profile"><i class="fas fa-user"></i> Profile</a>
        <a asp-page="/Logout" class="text-danger"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Top Navigation Bar -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">RadiantCourseRegistration</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Register">Register for Course</a>
                            </li>
                            <a asp-page="/Courses"><i class="fas fa-book"></i> View Courses</a>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Page Content -->
        <div class="content">
            <div class="container">
                @RenderBody()
            </div>
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
